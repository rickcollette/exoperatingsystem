10 REM BENCH: DOS benchmarks for any DOS, in Atari BASIC (EOS)
20 REM Jobs in D2:, frames from RTCLOK, results to D2:RESULT.TXT
30 REM ENTER "D2:BENCH.BAS" then RUN. An error: -its number
40 DIM R(12),W(12),S(64),T(64),B$(250),F$(20),G$(20),L$(40),D$(120)
50 FOR I=0 TO 34:READ A:POKE 1536+I,A:NEXT I
60 DATA 104,104,104,170,104,104,157,66,3,104,157,69,3,104,157,68,3
70 DATA 104,157,73,3,104,157,72,3,32,86,228,132,212,169,0,133,213,96
80 B$="A":B$(250)="A":B$(2)=B$
90 L$="0123456789012345678901234567890123456789"
100 FOR J=1 TO 12:R(J)=0:W(J)=0:NEXT J
110 GOTO 1100
1100 J=1:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,8,0,"D2:T1.DAT"
1110 FOR I=0 TO 4095:PUT #1,I-INT(I/256)*256:NEXT I
1120 CLOSE #1:GOSUB 9100:R(J)=T-T0
1200 J=2:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,4,0,"D2:T1.DAT"
1210 FOR I=0 TO 4095:GET #1,A:NEXT I
1220 CLOSE #1:GOSUB 9100:R(J)=T-T0
1300 J=3:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,8,0,"D2:T2.DAT"
1310 A=USR(1536,16,11,20480,16384):IF A>127 THEN 8020
1320 CLOSE #1:GOSUB 9100:R(J)=T-T0
1400 J=4:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,4,0,"D2:T2.DAT"
1410 A=USR(1536,16,7,20480,16384):IF A>127 AND A<>136 THEN 8020
1420 CLOSE #1:GOSUB 9100:R(J)=T-T0
1500 J=5:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,8,0,"D2:T3.DAT"
1510 FOR I=1 TO 200:PRINT #1;L$:NEXT I
1520 CLOSE #1:GOSUB 9100:R(J)=T-T0
1600 J=6:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,4,0,"D2:T3.DAT"
1610 FOR I=1 TO 200:INPUT #1,L$:NEXT I
1620 CLOSE #1:GOSUB 9100:R(J)=T-T0
1700 J=7:TRAP 8000:GOSUB 9100:T0=T
1710 FOR I=1 TO 30:F$="D2:F":F$(5)=STR$(I):OPEN #1,8,0,F$:PUT #1,65:CLOSE #1:NEXT I
1720 GOSUB 9100:R(J)=T-T0
1800 J=8:TRAP 8000:GOSUB 9100:T0=T:OPEN #1,6,0,"D2:*.*":TRAP 1830
1810 INPUT #1,D$:GOTO 1810
1830 IF PEEK(195)<>136 THEN 8000
1840 TRAP 8000:CLOSE #1:GOSUB 9100:R(J)=T-T0
1900 J=9:TRAP 8000:GOSUB 9100:T0=T
1910 FOR I=1 TO 20:OPEN #1,4,0,"D2:F30":CLOSE #1:NEXT I
1920 GOSUB 9100:R(J)=T-T0
2000 J=10:TRAP 8000:OPEN #1,8,0,"D2:T4.DAT"
2010 FOR I=1 TO 64:NOTE #1,SS,BB:S(I)=SS:T(I)=BB:PRINT #1;B$:NEXT I:CLOSE #1
2020 E=0:GOSUB 9100:T0=T:OPEN #1,4,0,"D2:T4.DAT"
2030 FOR I=1 TO 64:K=I*37-INT(I*37/64)*64+1:SS=S(K):BB=T(K):POINT #1,SS,BB:GET #1,A:IF A<>65 THEN E=E+1
2040 NEXT I:CLOSE #1:GOSUB 9100:R(J)=T-T0:IF E THEN R(J)=-1
2100 J=11:TRAP 8000:GOSUB 9100:T0=T
2110 FOR I=1 TO 30:F$="D2:F":F$(5)=STR$(I):F$(LEN(F$)+1)=",G":F$(LEN(F$)+1)=STR$(I)
2120 XIO 32,#1,0,0,F$:NEXT I
2130 GOSUB 9100:R(J)=T-T0
2200 J=12:TRAP 8000:GOSUB 9100:T0=T
2210 FOR I=1 TO 30:F$="D2:G":F$(5)=STR$(I):XIO 33,#1,0,0,F$:NEXT I
2220 GOSUB 9100:R(J)=T-T0
3000 TRAP 40000:OPEN #2,8,0,"D2:RESULT.TXT":RESTORE 3100
3010 FOR J=1 TO 12:READ G$:PRINT #2;G$;" ";R(J);" ";W(J):PRINT G$;" ";R(J):NEXT J
3020 PRINT #2;"END":CLOSE #2:PRINT "END":END
3100 DATA PUTBYTE,GETBYTE,BLKWRITE,BLKREAD,RECWRITE,RECREAD,CREATE,DIR,OPEN,SEEK,RENAME,DELETE
8000 R(J)=-PEEK(195):W(J)=PEEK(186)+256*PEEK(187)
8010 TRAP 40000:FOR K=1 TO 3:CLOSE #K:NEXT K:GOTO 8030
8020 R(J)=-A:CLOSE #1
8030 ON J GOTO 1200,1300,1400,1500,1600,1700,1800,1900,2000,2100,2200,3000
9100 A=PEEK(19):T=PEEK(20)+256*A+65536*PEEK(18):IF A<>PEEK(19) THEN 9100
9110 RETURN
